# Copy to .env. Docker Compose reads it automatically; for a local run, export the variables
# (the app reads the process environment and does not load .env itself).

# --- Providers: hosted models stay off unless you opt in and supply a key ---
OLLAMA_HOST=http://127.0.0.1:11434
LLM_ALLOW_PAID_PROVIDERS=false
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Storage (Docker Compose overrides these to use its persistent volume) ---
LLM_AUTOPILOT_DB=data/autopilot.sqlite3
# Optional writable copy of configs/routing.yaml for live updates via PUT /v1/routing-config.
LLM_ROUTING_RULES_PATH=

# --- Quality verification ---
# inline: verify inside the API process. queue: hand off to `python -m app.worker`
# (Docker Compose defaults to queue).
LLM_VERIFICATION_MODE=inline
LLM_VERIFICATION_WORKER_ENABLED=true
LLM_VERIFICATION_WORKER_POLL_SECONDS=0.5
LLM_VERIFICATION_JOB_LEASE_SECONDS=600

# --- Classifier retraining on recorded routing failures (seconds; default weekly) ---
LLM_RETRAIN_INTERVAL_SECONDS=604800
LOG_LEVEL=INFO
